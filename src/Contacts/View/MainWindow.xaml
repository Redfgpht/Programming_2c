<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="450" 
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Edit Contact" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Name:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,10" 
                     Padding="3"/>

            <TextBlock Text="Phone Number:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,10" 
                     Padding="3"/>

            <TextBlock Text="Email:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,10" 
                     Padding="3"/>

            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,10,0,0">
                <Button Content="Save" 
                        Width="75" 
                        Height="25" 
                        Margin="0,0,3,0"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Load" 
                        Width="75" 
                        Height="25" 
                        Margin="3,0,0,0"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </StackPanel>

        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch"
                      Background="Gray"/>

        <StackPanel Grid.Column="2" 
                    Margin="10,0,0,0">
            <TextBlock Text="Contact Information" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Name:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True"
                     Margin="0,0,0,10" 
                     Padding="3"
                     Background="#F0F0F0"/>

            <TextBlock Text="Phone number:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding PhoneNumber, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True"
                     Margin="0,0,0,10" 
                     Padding="3"
                     Background="#F0F0F0"/>

            <TextBlock Text="Email:" 
                       Margin="0,0,0,3"/>
            <TextBox Text="{Binding Email, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True"
                     Margin="0,0,0,10" 
                     Padding="3"
                     Background="#F0F0F0"/>
        </StackPanel>
    </Grid>
</Window>