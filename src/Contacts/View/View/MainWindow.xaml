<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
        mc:Ignorable="d"
        Title="Контакты" 
        Height="550" 
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список контактов -->
        <Grid Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Список контактов -->
                <ListBox Grid.Row="0" 
                         ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,3">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки управления -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="Add" 
                            Height="25" 
                            Width="60"
                            Margin="0,0,3,0"
                            Command="{Binding AddCommand}"
                            Padding="5,0"/>
                    <Button Content="Edit" 
                            Height="25" 
                            Width="60"
                            Margin="3,0,3,0"
                            Command="{Binding EditCommand}"
                            Padding="5,0"/>
                    <Button Content="Remove" 
                            Height="25" 
                            Width="60"
                            Margin="3,0,0,0"
                            Command="{Binding RemoveCommand}"
                            Padding="5,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Background="White"/>

        <!-- Правая панель: просмотр и редактирование контакта -->
        <Grid Grid.Column="2" Background="White">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Данные контакта -->
                <StackPanel Grid.Row="1" Margin="0,0,0,50">
                    <!-- Фото placeholder -->
                    <Border Width="100" 
                            Height="100" 
                            BorderBrush="Gray" 
                            BorderThickness="1" 
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock Text="Фото" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Поле Name -->
                    <TextBlock Text="Имя:" Margin="0,0,0,3"/>

                    <!-- Поле для ввода/отображения имени -->
                    <TextBox 
                        Text="{Binding CurrentContact.Name, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="{Binding IsViewMode}"
                        Margin="0,0,0,10" 
                        Padding="3">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="False">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Поле Phone -->
                    <TextBlock Text="Телефон:" Margin="0,0,0,3"/>

                    <!-- Поле для ввода/отображения телефона -->
                    <TextBox 
                        Text="{Binding CurrentContact.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="{Binding IsViewMode}"
                        Margin="0,0,0,10" 
                        Padding="3">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="False">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Поле Email -->
                    <TextBlock Text="Email:" Margin="0,0,0,3"/>

                    <!-- Поле для ввода/отображения email -->
                    <TextBox 
                        Text="{Binding CurrentContact.Email, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="{Binding IsViewMode}"
                        Margin="0,0,0,10" 
                        Padding="3">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsViewMode}" Value="False">
                                        <Setter Property="Background" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- Кнопки Apply и Cancel -->
                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10">
                    <Button Content="Apply" 
                            Width="75" 
                            Height="25"
                            Margin="0,0,5,0"
                            Command="{Binding ApplyCommand}"
                            Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button Content="Cancel" 
                            Width="75" 
                            Height="25"
                            Margin="5,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>