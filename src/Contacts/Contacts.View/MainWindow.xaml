<Window x:Class="Contacts.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Contacts.View.Controls"
        xmlns:converters="clr-namespace:Contacts.View.Converters"
        mc:Ignorable="d"
        Title="Контакты" 
        Height="550" 
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <DataTemplate x:Key="ContactTemplate">
            <Grid Margin="5,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Width="32" 
                        Height="32" 
                        Background="#CCCCCC" 
                        CornerRadius="16"
                        HorizontalAlignment="Left"
                        Margin="0,0,8,0">
                    <TextBlock Text="👤" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               FontSize="16"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" 
                               FontWeight="Bold" 
                               FontSize="14"/>
                    <TextBlock Text="{Binding PhoneNumber}" 
                               FontSize="12" 
                               Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список контактов -->
        <Grid Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" 
                         ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact, UpdateSourceTrigger=PropertyChanged}"
                         ItemTemplate="{StaticResource ContactTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,3"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="Добавить" 
                            Height="25" 
                            Width="70"
                            Margin="0,0,3,0"
                            Command="{Binding AddCommand}"
                            Padding="5,0"/>
                    <Button Content="Изменить" 
                            Height="25" 
                            Width="70"
                            Margin="8,0,3,0"
                            Command="{Binding EditCommand}"
                            Padding="5,0"/>
                    <Button Content="Удалить" 
                            Height="25" 
                            Width="70"
                            Margin="8,0,0,0"
                            Command="{Binding RemoveCommand}"
                            Padding="5,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Background="White"/>

        <Grid Grid.Column="2" Background="White">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ContactControl Grid.Row="0" 
                         DataContext="{Binding CurrentContact}"
                         IsViewMode="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10">
                    <Button Content="Применить" 
                            Width="75" 
                            Height="25"
                            Margin="0,0,5,0"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding IsApplyEnabled}"
                            Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button Content="Отмена" 
                            Width="75" 
                            Height="25"
                            Margin="5,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsApplyVisible, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>